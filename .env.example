# Kode rahasia yang harus dimasukkan petugas saat registrasi akun.
# Berikan hanya kepada petugas yang berwenang, dan GANTI sebelum deploy.
PETUGAS_CODE=TOBA2026
PORT=3000

# (Opsional) Akun petugas yang dibuat otomatis setiap server start.
# Disarankan di Vercel karena database di /tmp dapat dibuat ulang sewaktu-waktu.
PETUGAS_USERNAME=
PETUGAS_PASSWORD=
PETUGAS_NAMA=Petugas Lapangan

# (Opsional) Batasi origin front-end yang boleh mengakses API, pisahkan dengan koma.
# Contoh: https://ifs24054-pabwe2026-proyek1-fe.vercel.app
# Kosong = semua origin diizinkan (cukup untuk tugas kuliah).
CORS_ORIGIN=
